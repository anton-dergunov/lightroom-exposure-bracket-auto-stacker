# Tags the plugin reads, and the only tags kept in test fixtures: an exiftool argument file.
# Use with: exiftool -j -n -G1:4 -a -@ bracket-stacker.lrdevplugin/tags.args FILES
# (-G1:4 keeps repeated tags apart: Sony writes SequenceLength twice, as Sony:SequenceLength and
# Sony:Copy1:SequenceLength, and only one of them holds the real length.)
# Anything not listed here (serial numbers, owner names, GPS, paths) is never stored.

# Identity and ordering
-FileName
-Make
-Model
-Software
-DateTimeOriginal
-SubSecTimeOriginal
-SubSecTime
-SubSecDateTimeOriginal
-ShutterCount
-ImageCount

# Exposure
-ExposureMode
-ExposureProgram
-ExposureCompensation
-ExposureTime
-FNumber
-ISO
-HDR

# Drive and sequence tags shared by several vendors
-DriveMode
-DriveMode2
-ReleaseMode
-ShootingMode
-SequenceNumber
-AutoBracketing
-BracketShotNumber
-WhiteBalanceBracketing

# Sony
-ReleaseMode2
-ReleaseMode3
-SequenceImageNumber
-SequenceFileNumber
-SequenceLength
-BracketShotNumber2
-ExposureBracketShotNumber
-DynamicRangeOptimizerBracket

# Canon
-BracketMode
-BracketValue
-AEBBracketValue
-AutoExposureBracketing
-AEBShotCount
-AEBSequence
-ContinuousDrive
-WBBracketMode
-RawBurstImageCount
-RawBurstImageNum
-FocusBracketing
-FocusBracketingImageCount
-FocusBracketingFocusIncrement
-FocusBracketingDepthComposite

# Nikon
-ExposureBracketValue
-AutoBracketOrder
-AutoBracketSet
-AutoBracketModeM
-BracketSet
-BracketProgram
-BracketIncrement
-AEBracketingSteps
-FocusShiftShooting
-FocusShiftNumberShots
-BurstGroupID
-MultiExposureMode

# Fujifilm
-DriveSpeed
-ExposureCount

# Olympus / OM System
-StackedImage
-FocusBracketStepSize
-WhiteBalanceBracket
-PanoramaMode

# Panasonic
-BurstMode
-BracketSettings
-FocusBracket
-TimerRecording
-PostFocusMerging

# Pentax
-ExposureBracketStepSize
